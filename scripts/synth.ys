# Create target run directory if it does not exist
exec mkdir -p "systolic_project/runs/$ENV{RUN_TAG}"

# Read SystemVerilog RTL files with environment variable macro overrides
read_verilog -sv -DARRAY_SIZE=$ENV{ARRAY_SIZE} -DDATA_WIDTH=$ENV{DATA_WIDTH} rtl/pe.v
read_verilog -sv -DARRAY_SIZE=$ENV{ARRAY_SIZE} -DDATA_WIDTH=$ENV{DATA_WIDTH} rtl/systolic_array.v

# Top-level elaboration & generic netlist building
hierarchy -top systolic_array

# High-level synthesis passes
proc
flatten
opt
fsm
opt
memory
opt
techmap
opt

# Standard cell mapping targeting Sky130 HD Liberty
dfflibmap -liberty $ENV{LIB_FILE}
abc -liberty $ENV{LIB_FILE}
opt
clean

# Ensure output synthesis directory exists & write gate-level netlist
exec mkdir -p systolic_project/synth
write_verilog -noattr systolic_project/synth/systolic_netlist.v

# Log area report
tee -o "systolic_project/runs/$ENV{RUN_TAG}/yosys_synth_area.rpt" stat -liberty $ENV{LIB_FILE}
