# Parse SystemVerilog files with -sv flag
read_verilog -sv rtl/pe.v
read_verilog -sv rtl/systolic_array.v

# Elaborate top module and override parameters cleanly
hierarchy -top systolic_array -chparam N __ARRAY_SIZE__ -chparam WIDTH __DATA_WIDTH__

# High-level synthesis / optimization passes
proc
flatten
opt
fsm
opt
techmap
opt

# Write out gate-level netlist
write_verilog -noattr -noexpr -nohex -nodec systolic_project/synth/systolic_netlist.v
