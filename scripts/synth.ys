# 1. Read source files
read_verilog -sv rtl/pe.v
read_verilog -sv rtl/systolic_array.v

# 2. Elaborate hierarchy with parameters and keep top intact
hierarchy -check -top systolic_array -chparam N __ARRAY_SIZE__ -chparam WIDTH __DATA_WIDTH__

# 3. Direct synth pass to use the elaborated hierarchy without specifying top again
synth -flatten

# 4. Tech mapping & optimization
dfflibmap -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
clean

# 5. Output netlist
write_verilog -noattr systolic_project/synth/systolic_netlist.v
stat -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
