# Read SystemVerilog files with parameters defined prior to elaboration
read_verilog -sv -DARRAY_SIZE=__ARRAY_SIZE__ -DDATA_WIDTH=__DATA_WIDTH__ rtl/pe.v
read_verilog -sv -DARRAY_SIZE=__ARRAY_SIZE__ -DDATA_WIDTH=__DATA_WIDTH__ rtl/systolic_array.v

# Pure top-level elaboration (no -chparam needed)
hierarchy -top systolic_array

# Standard synthesis & cell mapping
proc
flatten
opt
fsm
opt
memory
opt
techmap
opt

# Standard cell mapping using container Liberty file
dfflibmap -liberty $env(LIB_FILE)
abc -liberty $env(LIB_FILE)
opt
clean

# Output gate-level netlist and area stats
write_verilog -noattr systolic_project/synth/systolic_netlist.v
stat -liberty $env(LIB_FILE)
