# Read SystemVerilog files using environment variables
read_verilog -sv -DARRAY_SIZE=$env(ARRAY_SIZE) -DDATA_WIDTH=$env(DATA_WIDTH) rtl/pe.v
read_verilog -sv -DARRAY_SIZE=$env(ARRAY_SIZE) -DDATA_WIDTH=$env(DATA_WIDTH) rtl/systolic_array.v

# Top-level elaboration
hierarchy -top systolic_array

# Optimization flow
proc
flatten
opt
fsm
opt
memory
opt
techmap
opt

# Technology mapping
dfflibmap -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
opt
clean

# Write outputs
write_verilog -noattr systolic_project/synth/systolic_netlist.v
tee -o "systolic_project/runs/$env(RUN_TAG)/yosys_synth_area.rpt" stat -liberty ./conda-env/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
