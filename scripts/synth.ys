# ================================================================
# Systolic Array Yosys Synthesis
# ================================================================

read_verilog -sv \
  -DARRAY_SIZE=__ARRAY_SIZE__ \
  -DDATA_WIDTH=__DATA_WIDTH__ \
  rtl/pe.v

read_verilog -sv \
  -DARRAY_SIZE=__ARRAY_SIZE__ \
  -DDATA_WIDTH=__DATA_WIDTH__ \
  rtl/systolic_array.v

hierarchy -top systolic_array

proc
flatten
opt

fsm
opt

memory
opt

techmap
opt

dfflibmap -liberty "__LIB_FILE__"

abc -liberty "__LIB_FILE__"

opt
clean

# ------------------------------------------------
# Netlist
# ------------------------------------------------

write_verilog \
  -noattr \
  systolic_project/synth/systolic_netlist.v

# ------------------------------------------------
# Synthesis statistics
# ------------------------------------------------

stat -liberty "__LIB_FILE__"
