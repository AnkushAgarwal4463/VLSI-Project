# Read SystemVerilog files, expanding environment variables using "$::env(...)"
read_verilog -sv -DARRAY_SIZE="$::env(ARRAY_SIZE)" -DDATA_WIDTH="$::env(DATA_WIDTH)" rtl/pe.v
read_verilog -sv -DARRAY_SIZE="$::env(ARRAY_SIZE)" -DDATA_WIDTH="$::env(DATA_WIDTH)" rtl/systolic_array.v

# Top-level elaboration
hierarchy -top systolic_array

# Standard synthesis & optimization flow
proc
flatten
opt
fsm
opt
memory
opt
techmap
opt

# Standard cell mapping using Sky130 HD Liberty file
dfflibmap -liberty "$::env(LIB_FILE)"
abc -liberty "$::env(LIB_FILE)"
opt
clean

# Output gate-level netlist and area stats
write_verilog -noattr systolic_project/synth/systolic_netlist.v
tee -o "systolic_project/runs/$::env(RUN_TAG)/yosys_synth_area.rpt" stat -liberty "$::env(LIB_FILE)"
